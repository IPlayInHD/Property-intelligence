# ── Core ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/propiq
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# ── Listing reader (Onyx Atlas URL analysis) ──────────────────────────────
SCRAPER_API_KEY=your_scraperapi_key_here
# SCRAPER_PROVIDER=scraperapi        # or scrapingbee
# SCRAPER_RENDER=false               # true = JS rendering (slower)
# SCRAPER_EXTRA=premium=true         # residential proxies if still blocked

# ── #1 UAE Real Estate API + #7 Bayut API (RapidAPI, one shared key) ───────
RAPIDAPI_KEY=your_rapidapi_key_here
# UAE_RE_RAPIDAPI_HOST=uae-real-estate-api.p.rapidapi.com
# BAYUT_RAPIDAPI_HOST=bayut.p.rapidapi.com

# ── #2 Google Geocoding / Places (Quality-of-Life module) ─────────────────
GOOGLE_PLACES_API_KEY=your_google_key_here

# ── #3 Dubai API Gallery — DLD Developer Details (GOV, OAuth 2.0) ──────────
DUBAI_DLD_CLIENT_ID=
DUBAI_DLD_CLIENT_SECRET=
DUBAI_DLD_DDA_KEY=
# DUBAI_DLD_TOKEN_URL=https://apis.dubai.gov.ae/oauth2/token
# DUBAI_DLD_BASE_URL=https://apis.dubai.gov.ae/secure/dld/developerdetails/1.0.0

# ── #4 Zyla UAE Real Estate Data API (Bearer) ─────────────────────────────
ZYLA_API_KEY=

# ── #9 Reelly (off-plan / primary market) ─────────────────────────────────
REELLY_API_KEY=

# ── #13 Makani — Dubai Municipality geo-addressing (GOV, OAuth 2.0) ────────
MAKANI_CLIENT_ID=
MAKANI_CLIENT_SECRET=

# ── Legacy / existing ─────────────────────────────────────────────────────
# DUBAI_PULSE_API_KEY=               # #5 (old Dubai Pulse OAuth — now open data)
# DUBAI_PULSE_API_SECRET=

# Open-data providers (#5 DLD, #11 Abu Dhabi, #12 Bayanat) need NO key —
# download the CSVs and load them with:  scripts/src/import-dld.ts
#
# Deferred (paid / partner / license): #6 DLD API Gateway, #8 PropertyFinder
# Enterprise, #10 Madhmoun (ADREC), #14 REIDIN — see docs/API-INTEGRATION.md.
